# Copy to .env for local configuration. This example keeps all requests offline.
ASSISTANT_PROVIDER=offline
PORT=4173

# Optional: select bedrock after setting up your AWS account and model access.
# Use your normal AWS SDK credential profile/SSO session, not keys pasted in chat.
# Bedrock requests incur charges under your AWS account's pricing.
# Choose a model/inference profile that supports Converse and tool use in this region.
# ASSISTANT_PROVIDER=bedrock
# AWS_REGION=your-aws-region
# BEDROCK_MODEL_ID=your-compatible-model-or-inference-profile-id
# AWS_PROFILE=your-local-profile
# BEDROCK_MAX_TURNS=6
